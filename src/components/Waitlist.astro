---
import { t, type Lang } from '../i18n';
interface Props { id: string; lang: Lang; }
const { id, lang } = Astro.props;
const w = t[lang].waitlist;
---
<form class="waitlist arrow" data-waitlist action="/api/waitlist" method="post" novalidate
  data-invalid={w.invalid} data-sending={w.sending} data-ok={w.ok} data-failed={w.failed}>
  <input type="hidden" name="lang" value={lang} />
  <label for={`${id}-email`}>{w.label}</label>
  <div class="row">
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email"
      placeholder={w.placeholder} spellcheck="false" autocapitalize="off" required aria-describedby={`${id}-msg`} />
    <button class="btn" type="submit">{w.button}</button>
  </div>
  <p id={`${id}-msg`} class="msg" role="status" aria-live="polite">{w.hint}</p>
</form>

<style>
  .waitlist {
    display: grid; gap: var(--u);
    padding-block: calc(var(--u) * 2.5);
    padding-left: calc(var(--u) * 3);
    box-shadow: var(--shadow);
  }
  label { font-weight: 800; font-size: 1.0625rem; }
  .row { display: flex; gap: var(--u); flex-wrap: wrap; }
  input {
    flex: 1 1 14rem; min-width: 0; min-height: 48px;
    font: inherit; font-size: 1.0625rem;
    padding: 0 calc(var(--u) * 1.75);
    border: 2px solid var(--ink); border-radius: calc(var(--u) * 0.75);
    background: #fff; color: var(--ink);
  }
  input::placeholder { color: var(--placeholder); }
  input[aria-invalid="true"] { border-color: #b0231a; }
  .msg { margin: 0; font-size: 0.9375rem; color: var(--ink-soft); }
  .msg[data-state="error"] { color: #b0231a; font-weight: 700; }
  .msg[data-state="ok"] { color: var(--field); font-weight: 800; }
</style>

<script>
  import { validEmail } from '../../api/waitlist.js';
  document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type=email]')!;
    const copy = form.dataset;
    const btn = form.querySelector('button')!;
    const msg = form.querySelector('.msg') as HTMLElement;
    const say = (text: string, state: string) => { msg.textContent = text; msg.dataset.state = state; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!validEmail(email)) {
        input.setAttribute('aria-invalid', 'true');
        say(copy.invalid!, 'error');
        input.focus();
        return;
      }
      input.removeAttribute('aria-invalid');
      btn.disabled = true;
      say(copy.sending!, 'loading');
      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) throw new Error(String(res.status));
        // Close this form, plus untouched ones so they don't invite a duplicate sign-up.
        // A form with its own email typed or in flight stays as it is.
        document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach((f) => {
          const i = f.querySelector<HTMLInputElement>('input[type=email]');
          if (f !== form && (!i || i.value.trim() || f.querySelector('button')?.disabled)) return;
          f.querySelector('.row')?.remove();
          const m = f.querySelector('.msg') as HTMLElement;
          m.textContent = f.dataset.ok!;
          m.dataset.state = 'ok';
        });
      } catch {
        btn.disabled = false;
        say(copy.failed!, 'error');
      }
    });
  });
</script>
