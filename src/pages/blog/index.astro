---
import Base from '../../layouts/Base.astro';
import content from '../../data/content.json';
import Dots from '../../components/Dots.astro';
const posts = content.posts;
---
<Base title="Blog · Lineagree" description="Guide su pedigree, enti di registrazione e accoppiamento responsabile per proprietari di animali di razza.">
  <section class="blog wrap" aria-labelledby="blog-title">
    <div class="board plate screws">
      <h1 id="blog-title">Guide su pedigree, enti e accoppiamento.</h1>
      <p class="sub">Per chi ha un animale con pedigree e vuole capire cosa c'è scritto, chi lo rilascia e come scegliere un partner.</p>
    </div>
    <ol class="list" role="list">
      {posts.map((p) => (
        <li>
          <a class="post plate" href={`/blog/${p.slug}`}>
            <span class="txt">
              <span class="meta"><Dots text={p.badge} /></span>
              <span class="t">{p.title}</span>
              <span class="ex">{p.excerpt}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .blog { padding-top: calc(var(--u) * 3); }
  .board { padding: calc(var(--u) * 5); max-width: 860px; }
  .board h1 { font-size: clamp(2.25rem, 5.2vw, 4.5rem); }
  .sub { margin: calc(var(--u) * 2) 0 0; font-size: 1.25rem; color: var(--ink-soft); }
  .list { list-style: none; padding: 0; margin: calc(var(--u) * 6) 0 0; display: grid; gap: calc(var(--u) * 3); max-width: 860px; }
  .post { display: block; padding: calc(var(--u) * 3.5) calc(var(--u) * 4); text-decoration: none; transition: transform 200ms var(--ease); }
  .post:hover { transform: translateX(6px); }
  .post:hover .t { color: var(--field); }
  .txt { display: grid; gap: var(--u); }
  .meta { font-weight: 700; font-size: 0.9375rem; color: var(--ink-soft); }
  .t { font-weight: 900; font-size: 1.5rem; line-height: 1.15; }
  .ex { color: var(--ink-soft); max-width: 62ch; }
  @media (max-width: 720px) {
    .post { padding: calc(var(--u) * 3) calc(var(--u) * 2.5); }
    .board { padding: calc(var(--u) * 3.5) calc(var(--u) * 2.5); }
  }
</style>
