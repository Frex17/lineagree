---
import Base from '../../layouts/Base.astro';
import Waitlist from '../../components/Waitlist.astro';
import content from '../../data/content.json';
import Dots from '../../components/Dots.astro';

export function getStaticPaths() {
  return content.posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const others = content.posts.filter((p) => p.slug !== post.slug).slice(0, 3);
---
<Base title={`${post.title} · Lineagree`} description={post.description || post.excerpt}>
  <article class="article wrap">
    <header class="art-head plate screws">
      <a class="back" href="/blog">Tutti gli articoli</a>
      <h1>{post.title}</h1>
      <p class="meta"><Dots text={post.badge} /></p>
    </header>
    <div class="prose plate" set:html={post.body} />
  </article>

  <aside class="more wrap" aria-labelledby="more-title">
    <h2 id="more-title">Altri articoli</h2>
    <ul role="list">
      {others.map((p) => <li><a class="arrow" href={`/blog/${p.slug}`}>{p.title}</a></li>)}
    </ul>
  </aside>

  <section class="cta wrap" aria-labelledby="cta-title">
    <h2 id="cta-title">Vuoi trovare un compagno di razza per il tuo animale?</h2>
    <div class="cta-form"><Waitlist id="post" /></div>
  </section>
</Base>

<style>
  .article { max-width: 860px; padding-top: calc(var(--u) * 3); }
  .art-head { padding: calc(var(--u) * 5) calc(var(--u) * 5) calc(var(--u) * 4); }
  .art-head h1 { font-size: clamp(2rem, 4vw, 3.25rem); margin-top: calc(var(--u) * 2); }
  .back { font-weight: 800; color: var(--field); }
  .meta { margin: calc(var(--u) * 2) 0 0; font-weight: 700; color: var(--ink-soft); }
  .prose { margin-top: calc(var(--u) * 3); }
  .prose { padding: calc(var(--u) * 5); font-size: 1.0625rem; line-height: 1.65; }
  .prose :global(p) { margin: 0 0 calc(var(--u) * 2.5); max-width: 34em; color: var(--ink); }
  .prose :global(h2) { font-size: 1.5rem; margin: calc(var(--u) * 5) 0 calc(var(--u) * 1.5); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(strong) { font-weight: 800; }
  .prose :global(a) { color: var(--field); font-weight: 700; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.25em; max-width: 33em; }
  .prose :global(li) { margin-bottom: var(--u); }
  .more { max-width: 860px; padding-top: calc(var(--u) * 8); }
  .more h2 { font-size: clamp(1.875rem, 3.4vw, 2.75rem); }
  .more ul { list-style: none; padding: 0; margin: calc(var(--u) * 3) 0 0; display: grid; gap: calc(var(--u) * 1.5); }
  .more a {
    display: block; padding-block: calc(var(--u) * 2); padding-left: calc(var(--u) * 2.5);
    font-weight: 800; font-size: 1.0625rem; text-decoration: none; max-width: 640px;
    filter: drop-shadow(0 2px 2px rgb(6 38 20 / 0.35)) drop-shadow(0 10px 14px rgb(6 38 20 / 0.3));
    transition: transform 200ms var(--ease);
  }
  .more a:hover { transform: translateX(6px); }
  .cta { max-width: 860px; padding-top: calc(var(--u) * 10); display: grid; gap: calc(var(--u) * 3); }
  .cta h2 { font-size: clamp(1.875rem, 3.4vw, 2.75rem); max-width: 22ch; }
  .cta-form { max-width: 640px; }
  @media (max-width: 520px) {
    .art-head, .prose { padding: calc(var(--u) * 3) calc(var(--u) * 2.5); }
    .prose { font-size: 1.0625rem; }
  }
</style>
