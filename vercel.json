{
  "regions": ["dub1"],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/termini",
      "destination": "/it/termini",
      "permanent": true
    },
    {
      "source": "/enciclopedia",
      "destination": "/it/enciclopedia",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/it/blog",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/it/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/it/blog/:slug",
      "permanent": true
    },
    {
      "source": "/specie/:slug",
      "destination": "/it/specie/:slug",
      "permanent": true
    }
  ]
}
